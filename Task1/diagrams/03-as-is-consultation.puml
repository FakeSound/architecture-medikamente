@startuml DFD_03_MedConsultation
title DFD 3: Приём пациента врачом

skinparam defaultTextAlignment center
skinparam rectangle {
  BackgroundColor<<ext>>  #DAE8FC
  BorderColor<<ext>>      #6C8EBF
  FontStyle<<ext>>        bold
  BackgroundColor<<proc>> #D5E8D4
  BorderColor<<proc>>     #82B366
}
skinparam database {
  BackgroundColor #FFF2CC
  BorderColor     #D6B656
}
skinparam arrow {
  Color     #444444
  FontSize  10
  FontColor #444444
}
skinparam shadowing false

' ── Акторы ──────────────────────────────────────
rectangle "Пациент"  <<ext>> as PAT
rectangle "Врач"     <<ext>> as DOC

' ── Процессы ─────────────────────────────────────
rectangle "3.1\nИдентификация\nпациента"            <<proc>> as P31
rectangle "3.2\nОсмотр и постановка\nдиагноза"      <<proc>> as P32
rectangle "3.3\nОформление /\nобновление медкарты"  <<proc>> as P33
rectangle "3.4\nВыдача назначений\nи направлений"   <<proc>> as P34

' ── Хранилища данных ─────────────────────────────
database "D1: Картотека пациентов\nExcel · файловый сервер"          as D1
database "D5: Медицинские карты\nPDF / JPG-сканы · файловый сервер"  as D5
database "D2: Журнал приёма\nExcel · файловый сервер"                as D2

' ── Потоки данных ────────────────────────────────
DOC --> P31 : Инициирует приём

PAT --> P31 : Устная идентификация — ФИО
D1  --> P31 : Карточка пациента\n[чтение]

P31 --> P32 : Данные пациента + история
D5  --> P32 : История болезни — PDF/JPG\n[чтение]

PAT --> P32 : Жалобы (устно)

P32 --> P33 : Результаты осмотра · диагноз
P33 --> D5  : Запись в медкарту (скан/PDF)\n[запись]
P33 --> D2  : Запись в журнал приёма\n[запись]

P32 --> P34 : Назначения · рецепты
P34 --> PAT : Направление на анализы · рецепт

@enduml
